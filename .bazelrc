# =============================================================================
# 1. STANDARDS & TOOLING
# =============================================================================
build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20
build --conlyopt=-std=gnu11

# Ensure Bazel uses the correct system paths for the compiler
build --action_env=CC
build --action_env=CXX
build --action_env=CGO_CPPFLAGS="-std=c++20"

# Python configuration for modern Bazel toolchains
build --python_version=PY3
build --incompatible_use_python_toolchains=false
build --action_env=PYTHON_BIN=/usr/bin/python3

# Apply build:linux on Linux hosts and build:macos on macOS hosts.
common --enable_platform_specific_config

# Prevent ld.gold AArch64 internal crash on Cortex-A53 erratum 843419 (PR gold/21868)
# GNU ld/gold only; Apple's ld64 rejects it.
build:linux --linkopt=-Wl,--no-fix-cortex-a53-843419
build:linux --host_linkopt=-Wl,--no-fix-cortex-a53-843419

# macOS: build C/C++ with apple_support's Xcode toolchain; the autoconfigured
# bazel_tools one rejects Xcode 16+'s implicit SDKSettings.json compile input.
# The macOS-only repos below are named canonically (Bazel 7 "~" form) so that
# MODULE.bazel needs no new bazel_dep: that would reorder toolchain registration
# for every platform, Linux included.
build:macos --extra_toolchains=@@apple_support~~apple_cc_configure_extension~local_config_apple_cc_toolchains//:all
# Otherwise the deployment target defaults to the SDK version, so binaries
# would refuse to run on any macOS older than the Xcode that built them.
build:macos --macos_minimum_os=14.0
build:macos --host_macos_minimum_os=14.0

# macOS: use the system make and pkg-config for rules_foreign_cc (ICU's
# configure_make) instead of bootstrapping them. The bootstraps are exec-config
# builds, where Bazel always strips, and apple_support's STRIP_DEBUG_SYMBOLS
# link flag breaks their configure probes (they link without -o, so strip gets
# an empty path).
build:macos --extra_toolchains=@@rules_foreign_cc~//toolchains:preinstalled_make_toolchain
build:macos --extra_toolchains=@@rules_foreign_cc~//toolchains:preinstalled_pkgconfig_toolchain
# The default --strip=sometimes strips fastbuild links, and apple_support's
# STRIP_DEBUG_SYMBOLS then fails ICU's configure probes in the target config the
# same way. -c opt (the release build) never strips.
build:macos --strip=never

# =============================================================================
# 2. COMPILER COMPATIBILITY (GCC 11+ FIXES)
# =============================================================================
# Force-Include headers often missing in modern gRPC/GoogleSQL prunings
build --cxxopt=-include --cxxopt=limits
build --cxxopt=-include --cxxopt=string
build --cxxopt=-include --cxxopt=cstdint

# Macros to expose C99/C++11 features in strict system libraries
build --cxxopt=-D_GNU_SOURCE
build --copt=-D_GNU_SOURCE
build --cxxopt=-D_GLIBCXX_USE_C99=1
build --cxxopt=-D_GLIBCXX_USE_CXX11_ABI=1

# =============================================================================
# 3. PERFORMANCE & RESOURCE MANAGEMENT
# =============================================================================
# Define the order of preference for spawn strategies.
build --spawn_strategy=local,worker,standalone

# Set resource limits for Docker builds.
build --jobs=auto  # Let Bazel decide parallelism based on budget
build --local_resources=memory=HOST_RAM*0.7  # Leave 30% for the OS/Docker overhead
build --local_resources=cpu=HOST_CPUS

# Use workers for compiler heavy tasks.
build --strategy=ProtoCompile=worker,local,standalone
build --strategy=Javac=worker,local,standalone
build --strategy=CppCompile=local,standalone
build --worker_max_instances=4  # Even if you have 16 CPUs, limit persistent workers to 4
build --worker_quit_after_build  # Clean up for Docker layers
build --experimental_worker_memory_limit_mb=512

# Use pre-built ProtoC from Ubuntu repositories to speed up Docker builds
build --action_env=PROTOC=/usr/bin/protoc
build --proto_compiler=@com_google_protobuf//:protoc
build --incompatible_enable_proto_toolchain_resolution=false

# =============================================================================
# 4. WARNINGS & STRICTNESS (LEGACY/GOOGLESQL SUPPRESSION)
# =============================================================================
build --cxxopt=-fpermissive
build --copt=-DNDEBUG

# Suppress warnings that trigger massive logs in GoogleSQL/Postgres code
build --copt=-Wno-all
build --copt=-Wno-sign-compare
build --copt=-Wno-deprecated-declarations
build --copt=-Wno-return-type
build --copt=-Wno-unused-but-set-parameter

# =============================================================================
# 5. TEST SETTINGS
# =============================================================================
test --test_env=GCLOUD_DIR

# Inform GoogleTest and gMock that Abseil libraries are available
build --define=absl=1
build --cxxopt=-DGTEST_HAS_ABSL=1

# =============================================================================
# 6. CI (see FORK.md)
# =============================================================================
# CI passes --config=ci on the command line, so it overrides --jobs=auto above.
# Per-job cache, credential and cache-silo flags come from /etc/bazel.bazelrc.
# Generated C++ files can exceed 5 GiB per compiler: two jobs fit 16-GiB runners.
build:ci --jobs=2
build:ci --compilation_mode=opt
# Fetch only what local actions need; the build job asks for its binaries.
build:ci --remote_download_minimal
# Re-run actions whose cached outputs were deleted by the bucket lifecycle.
build:ci --experimental_remote_cache_eviction_retries=5
build:ci --verbose_failures
test:ci --test_output=errors
