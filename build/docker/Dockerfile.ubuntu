################################################################################
#                                     BUILD                                    #
################################################################################

# CI builds `toolchain` (or `test-toolchain`) once per run and runs Bazel in it
# with a remote cache; it then builds only the release stage, replacing `build`
# with its prebuilt outputs (`--build-context build=...`). Local builds use every
# stage below.
FROM ubuntu:22.04@sha256:b8b6ee6aa931ecd9d0d952abc34dc0e5f7c6a30c6bb71b079fe399fde0329c02 AS toolchain

# Perform all APT installs in a single layer to reduce image size.
ENV GCC_VERSION=13
ARG DEBIAN_FRONTEND="noninteractive"
ARG TZ="America/Los_Angeles"
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    tar \
    wget \
    zip \
    unzip \
    git \
    make \
    rename \
    software-properties-common \
    gnupg \
    build-essential \
    ca-certificates \
    libgnutls30 \
    tzdata \
    language-pack-en \
    default-jre \
    default-jdk \
    protobuf-compiler \
    python3 \
    && add-apt-repository ppa:ubuntu-toolchain-r/test -y \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       gcc-${GCC_VERSION} \
       g++-${GCC_VERSION} \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-${GCC_VERSION} 90 \
       --slave /usr/bin/g++ g++ /usr/bin/g++-${GCC_VERSION} \
    && apt-get install -y --no-install-recommends --only-upgrade libstdc++6

# Create a symlink so 'python' points to 'python3'
RUN ln -s /usr/bin/python3 /usr/bin/python

# Install Bazelisk
ENV USE_BAZEL_VERSION=7.6.1
ARG TARGETARCH
RUN wget -O /usr/local/bin/bazel https://github.com/bazelbuild/bazelisk/releases/download/v1.17.0/bazelisk-linux-${TARGETARCH} \
    && chmod +x /usr/local/bin/bazel \
    && bazel --version

# Bazel does not hash the system compiler or headers into action keys. CI
# partitions its remote cache by this key, so a toolchain upgrade starts a fresh
# cache instead of mixing objects from two compilers.
RUN { dpkg --print-architecture && echo "bazel ${USE_BAZEL_VERSION}" \
      && dpkg-query --show gcc-${GCC_VERSION} g++-${GCC_VERSION} cpp-${GCC_VERSION} \
         libstdc++-${GCC_VERSION}-dev libgcc-${GCC_VERSION}-dev libc6-dev binutils \
         protobuf-compiler python3; } > /etc/bazel-toolchain.txt \
    && sha256sum < /etc/bazel-toolchain.txt | cut -c1-16 > /etc/bazel-toolchain-key

WORKDIR /src

# CI test shards: tests/gcloud needs a pinned Google Cloud CLI. The version is
# in GCLOUD_DIR, which `--test_env` puts in every test's cache key, so a new CLI
# re-runs the tests without invalidating compiled outputs.
FROM toolchain AS test-toolchain
ENV GCLOUD_VERSION=586.0.0
RUN curl --fail --location --retry 3 \
       https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-${GCLOUD_VERSION}-linux-x86_64.tar.gz \
       --output /tmp/gcloud.tar.gz \
    && echo '6c774c76793eedd501150b59da653610fbe3eaac169e822965b722de75a2f001  /tmp/gcloud.tar.gz' | sha256sum --check - \
    && tar -xzf /tmp/gcloud.tar.gz -C /opt \
    && mv /opt/google-cloud-sdk "/opt/google-cloud-sdk-${GCLOUD_VERSION}" \
    && rm /tmp/gcloud.tar.gz
ENV GCLOUD_DIR=/opt/google-cloud-sdk-${GCLOUD_VERSION}/bin
RUN "${GCLOUD_DIR}/gcloud" version

FROM toolchain AS deps
# Keep the upstream local default; use --build-arg BAZEL_JOBS=2 on small VMs.
ARG BAZEL_JOBS=auto
COPY build/bazel build/bazel/
COPY MODULE.bazel MODULE.bazel.lock* .bazelversion .bazelrc BUILD.bazel \
    requirements.txt go.mod go.sum ./
# Keep the compiled dependencies in their own layer for local rebuilds.
RUN bazel build -c opt --jobs="${BAZEL_JOBS}" \
    @com_github_grpc_grpc//:grpc++ \
    @com_google_protobuf//:protobuf \
    @com_google_googlesql//googlesql/public:analyzer

FROM deps AS build
# Copy over the emulator code base into the container.
COPY . .

# Make enum NodeTag compatible with both C and C++. The CI workflow applies the
# same edit before running Bazel.
RUN find third_party/spanner_pg -name "nodes.h" -exec sed -i 's/enum NodeTag : int/enum NodeTag/g' {} +

# Build the emulator binaries only.
# Since we are only copying the binaries to the release image, we don't need to
# build the rest of the targets.
ENV EXTRA_BAZEL_ARGS="--tool_java_runtime_version=local_jdk"
RUN bazel build -c opt --jobs="${BAZEL_JOBS}" \
    //binaries:emulator_main \
    //binaries:gateway_main \
    && bazel shutdown

# Generate licenses file. The CI workflow runs the same loop.
RUN for file in $(find -L bazel-src/external                               \
                       -name "LICENSE" -o -name "COPYING")                   ; \
    do                                                                         \
      echo "----"                                                            ; \
      echo $file                                                             ; \
      echo "----"                                                            ; \
      cat $file                                                              ; \
    done > licenses.txt                                                     && \
    gzip licenses.txt

################################################################################
#                                   RELEASE                                    #
################################################################################

# Now build the release image from the build image. Only these paths are read
# from `build`; CI's prebuilt replacement provides exactly them.
FROM gcr.io/distroless/cc-debian12

# Copy binaries.
COPY --from=build /src/bazel-bin/binaries/emulator_main .
COPY --from=build /src/bazel-bin/binaries/gateway_main_/gateway_main .

# Copy the libstdc++.so.6 shared library. We use wildcards to execute a conditional
# copy depending on the target architecture.
COPY --from=build /usr/lib/x86_64-linux-gnu*/libstdc++.so.6 /usr/lib/x86_64-linux-gnu
COPY --from=build /usr/lib/aarch64-linux-gnu*/libstdc++.so.6 /usr/lib/aarch64-linux-gnu

# Copy licenses
COPY --from=build /src/licenses.txt.gz .

# Expose the default ports 9010 (gRPC) and 9020 (REST)
EXPOSE 9010 9020

# Run the gateway process, bind to 0.0.0.0 as under MacOS, listening on
# localhost will make the server invisible outside the container.
CMD ["./gateway_main", "--hostname", "0.0.0.0"]
